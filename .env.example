# =============================================================================
# Banco de Questões — variáveis de ambiente (frontend Vite)
# =============================================================================
# 1. Copie este arquivo para `.env` na raiz do projeto:
#    cp .env.example .env
# 2. Preencha com os dados do projeto Supabase (Settings → API).
# 3. Reinicie o servidor: npm run dev
#
# Apenas variáveis com prefixo VITE_ são expostas ao browser.
# Nunca commite `.env` ou `.env.local` no Git.
# =============================================================================

# URL do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anon/public (segura para o frontend com RLS habilitado)
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
